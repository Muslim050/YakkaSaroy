# Signs session cookies. Required in production, 32+ characters: openssl rand -base64 32
AUTH_SECRET=

# Password for the "admin" account instead of the demo one
ADMIN_PASSWORD=

# Uploads of catalog photos and videos (Vercel Blob, public store). Added automatically
# when a Blob store is connected to the Vercel project; locally: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
